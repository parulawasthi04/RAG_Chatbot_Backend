{
  "name": "backend",
  "version": "1.0.0",
  "description": "RAG-powered chatbot backend",
  "main": "src/app.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "ingest": "node src/scripts/ingestNews.js",
    "ingest-sample": "node src/scripts/ingestSampleData.js",
    "setup-db": "node src/scripts/setupDatabase.js",
    "setup-qdrant": "node src/scripts/setupQdrant.js",
    "scrape-news": "node -e \"require('./src/services/webScrapingNewsService').ingestFromWebScraping().then(() => console.log('Done'))\"",
    "ingest-guardian": "node -e \"require('./src/services/guardianNewsService').ingestFromGuardian().then(() => console.log('Guardian scraping completed')).catch(console.error)\"",
    "test": "jest",
    "test-apis": "node src/scripts/testApiKeys.js",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "rag",
    "chatbot",
    "news",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.15.1",
    "axios": "^1.12.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "morgan": "^1.10.1",
    "mysql2": "^3.14.5",
    "redis": "^5.8.2",
    "rss-parser": "^3.13.0",
    "uuid": "^9.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "jest": "^30.1.3",
    "nodemon": "^3.1.10"
  }
}
